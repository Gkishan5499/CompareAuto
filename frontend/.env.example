# CDN Configuration
# Set to 'true' to use CDN for images, 'false' for local public folder
VITE_USE_CDN=false

# CDN Base URL (e.g., https://cdn.example.com or https://your-bucket.s3.amazonaws.com)
# Only used when VITE_USE_CDN=true
VITE_CDN_BASE_URL=

# Application Configuration
VITE_DEFAULT_CITY=delhi-ncr
VITE_API_URL = http://localhost:5000/api
